# Copy to ~/skill-match/.env on the server and fill in. Never commit the real file.

# Public hostname: the Elastic IP with dashes + .sslip.io (e.g. 3-15-120-8.sslip.io), or your own domain
API_DOMAIN=

# RDS endpoint from the RDS console ("Connectivity & security")
PROD_DB_URL=jdbc:postgresql://<rds-endpoint>:5432/skillmatch?sslmode=require
PROD_DB_USERNAME=skillmatch
PROD_DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

# Admin created on first startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend origins allowed by CORS, comma-separated (add the production URL when there is one)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
